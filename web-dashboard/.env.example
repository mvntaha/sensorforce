# FreshGuard environment template.
# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env

# --- Flask ---
FG_SECRET_KEY=change-me-to-a-long-random-string
FG_HOST=0.0.0.0
FG_PORT=5000
FG_DEBUG=0

# --- Database (SQLite, WAL mode, local source of truth) ---
FG_DB_PATH=freshguard.db

# --- Sensors ---
# real = Raspberry Pi hardware, sim = simulator (laptop, tests, evidence runs)
FG_SENSOR_MODE=sim
# Simulator scenario: normal | high_temp | high_humidity | gas_spike | door_open |
#                     sensor_disconnected | dht_intermittent
FG_SIM_SCENARIO=normal
# Optional: a file holding a scenario name, re-read every poll so a live demo
# can switch scenarios without restarting the monitor.
FG_SIM_CONTROL_FILE=
FG_POLL_INTERVAL_S=1
# Identifies this Pi in the cloud event payloads
FG_DEVICE_ID=pi-01

# --- First admin account (seeded once, then remove the password) ---
FG_ADMIN_USERNAME=admin
FG_ADMIN_PASSWORD=

# --- Email notification (SMTP, app password - never a real account password) ---
# SMTP_FROM should be the SAME address as SMTP_USER unless it is a verified
# alias on that account. Gmail rewrites a From it does not recognise, and some
# receivers score the resulting mismatch as spam.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=1

# --- Push notification (ntfy) ---
# The second remote-notification channel, and the one that needs no account:
# install the ntfy app, subscribe to the topic below, and alerts arrive.
# Both channels are tried on every alert and one success is enough.
#
# A topic on a public server is readable by ANYONE who knows its name, and an
# alert names a storage zone and can name a food item. Use a long random topic
# that nobody would guess, for example freshguard-7f3a9c2e8b1d4a6f, and change
# it if it is ever shared.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Only for a topic protected by access control on your own ntfy server.
NTFY_TOKEN=

# --- Firebase Realtime Database (cloud replica) ---
# Path to the service-account JSON. The file itself is git-ignored.
FIREBASE_CRED_PATH=
FIREBASE_DB_URL=
FG_SYNC_INTERVAL_S=10

# --- HTTPS (camera access for the QR scanner needs a secure context) ---
FG_TLS_CERT=
FG_TLS_KEY=
